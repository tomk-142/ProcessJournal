**Language:** Python

```python
"""
Narcissus printer
Watches TouchDesigner's captures folder and prints each new photo on the
thermal printer (through the Arduino Uno).

Setup:  pip install pyserial pillow
Run:    py narcissus_print.py      (leave it running next to TD)
"""
import glob
import os
import re
import time

import serial
from PIL import Image, ImageEnhance, ImageOps

# ===== Settings =====
CAPTURE_FOLDER = r"C:\Users\tomas\Desktop\narcissus_project\captures"  # the folder TD saves into
FILE_PATTERN = "narcissus_*.png"   # only print files that match this name
PORT = "COM8"          # the Uno's port (Arduino IDE > Tools > Port)
BAUD = 9600            # must match the self-test page AND the Uno sketch
PRINT_WIDTH = 384      # dots across (58mm printers are 384)

BRIGHTNESS = 1.2       # thermal prints come out dark: raise to lighten
CONTRAST = 1.3         # raise for punchier blacks and whites
HEAT_TIME = 120        # printer heat: higher = darker (about 50-200)

ROWS_PER_CHUNK = 5     # small chunks so the printer's buffer never overflows
ROW_PRINT_TIME = 0.02  # seconds the printer needs per row of dots
                       # (raise if the image turns to garbage partway down)
MAX_HEIGHT = 288       # crop taller images to this many rows (fewer rows = faster)

FOOTER = True          # print a title and the time under the photo


def prepare(path):
    """Resize, tweak and dither the photo to pure black and white."""
    img = Image.open(path).convert("L")
    height = round(img.height * PRINT_WIDTH / img.width)
    img = img.resize((PRINT_WIDTH, height), Image.LANCZOS)
    if height > MAX_HEIGHT:  # crop tall (portrait) photos around the middle
        top = (height - MAX_HEIGHT) // 2
        img = img.crop((0, top, PRINT_WIDTH, top + MAX_HEIGHT))
    img = ImageOps.autocontrast(img)
    img = ImageEnhance.Contrast(img).enhance(CONTRAST)
    img = ImageEnhance.Brightness(img).enhance(BRIGHTNESS)
    return img.convert("1")  # Floyd-Steinberg dithering


def print_image(ser, img, bpm=None):
    row_bytes = PRINT_WIDTH // 8
    # In the image 1 = white, but the printer wants 1 = black dot, so flip the bits
    data = bytes(b ^ 0xFF for b in img.tobytes())

    ser.write(b"\x1b@")                                # reset printer
    ser.write(bytes([0x1B, 0x37, 11, HEAT_TIME, 40]))  # heat settings
    ser.flush()
    time.sleep(0.5)

    for y in range(0, img.height, ROWS_PER_CHUNK):
        rows = min(ROWS_PER_CHUNK, img.height - y)
        chunk = data[y * row_bytes:(y + rows) * row_bytes]
        ser.write(bytes([0x12, 0x2A, rows, row_bytes]))  # "bitmap chunk coming"
        ser.write(chunk)
        ser.flush()
        # flush() already waits for the bytes to send, so just give the
        # printer time to burn the rows
        time.sleep(rows * ROW_PRINT_TIME)

    if FOOTER:
        ser.write(b"\x1ba\x01")  # centre text
        ser.write(b"\nNARCISSUS\n")
        if bpm:
            ser.write(f"{bpm} BPM\n".encode())
        ser.write(time.strftime("%d/%m/%Y %H:%M").encode() + b"\n")
        ser.write(b"\x1ba\x00")  # back to left

    ser.write(b"\n\n\n\n")       # feed the paper out past the tear bar
    ser.flush()


def main():
    pattern = os.path.join(CAPTURE_FOLDER, FILE_PATTERN)
    printed = set(glob.glob(pattern))  # skip photos that are already there

    ser = serial.Serial(PORT, BAUD)
    time.sleep(2)  # the Uno restarts when the port opens
    print("Watching", CAPTURE_FOLDER, "- press Ctrl+C to stop")

    while True:
        for path in sorted(glob.glob(pattern)):
            if path in printed:
                continue
            printed.add(path)
            time.sleep(0.5)  # let TD finish writing the file
            print("Printing", os.path.basename(path))
            try:
                # TD puts the heart rate in the filename, e.g. narcissus_..._72bpm.png
                match = re.search(r"_(\d+)bpm", os.path.basename(path))
                bpm = int(match.group(1)) if match else None
                print_image(ser, prepare(path), bpm)
            except Exception as e:
                print("  Failed:", e)
        time.sleep(0.5)


if __name__ == "__main__":
    main()
```